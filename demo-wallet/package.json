{
  "name": "demo-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "A small wallet and checkout API with real business rules. Canary's agents try to break it.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/migrate.ts --reset",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
