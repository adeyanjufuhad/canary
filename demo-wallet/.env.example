# Copy to demo-wallet/.env to run the API without Docker. Never commit the real file.

# Any Postgres 14+ database. Run `npm run db:setup` once to create the tables and demo data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full

# A separate database the tests are allowed to wipe (they drop and recreate the tables).
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/demo_wallet_test?sslmode=verify-full

PORT=4000
