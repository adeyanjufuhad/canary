# Copy to .env (repo root) or web/.env.local (landing page) and fill in real values.
# Never commit the real files.

# --- Landing page waitlist (web/) ---
# Neon Postgres connection string for the canary-web project
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Demo stack (docker-compose, local only) ---
POSTGRES_USER=canary
POSTGRES_PASSWORD=change-me
POSTGRES_DB=demo_wallet
DEMO_API_PORT=4000

# --- Agents (Switch providers) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# --- GitHub (Blue pushes the fix + regression test) ---
GITHUB_TOKEN=your-github-token
